<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Vigilance météo</title>

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #eef3f8;
    }

    header {
        background: #14213d;
        color: white;
        padding: 18px;
        text-align: center;
    }

    h1 {
        margin: 0;
    }

    #carte {
        width: 100%;
        max-width: 1100px;
        margin: 20px auto;
        display: block;
    }

    .departement {
        stroke: white;
        stroke-width: 0.8;
        cursor: pointer;
        transition: opacity 0.15s;
    }

    .departement:hover {
        opacity: 0.7;
        stroke: #111827;
        stroke-width: 1.5;
    }

    #infos {
        max-width: 500px;
        margin: 20px auto;
        background: white;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.12);
    }

    .vert { fill: #35a853; }
    .jaune { fill: #f5d000; }
    .orange { fill: #f28c00; }
    .rouge { fill: #d71920; }
</style>
</head>

<body>

<header>
    <h1>🌦️ Vigilance Météo France</h1>
    <p>Carte nationale des départements</p>
</header>

<svg id="carte" viewBox="0 0 900 700"></svg>

<div id="infos">
    <h2>Département</h2>
    <p>Clique sur un département.</p>
</div>

<script type="module">

const d3 = await import(
    "https://cdn.jsdelivr.net/npm/d3@7.9.0/+esm"
);

const geo = await import(
    "https://raw.githubusercontent.com/gregoiredavid/france-geojson/master/departements-version-simplifiee.geojson",
    { with: { type: "json" } }
);

const donnees = geo.default;

const svg = d3.select("#carte");

const largeur = 900;
const hauteur = 700;

const projection = d3.geoMercator()
    .fitSize(
        [largeur, hauteur],
        donnees
    );

const path = d3.geoPath()
    .projection(projection);


/* --------------------------------
   VIGILANCE
-------------------------------- */

const vigilance = {};

/* Tous les départements commencent en vert */

donnees.features.forEach(dep => {

    vigilance[dep.properties.code] = {
        niveau: "vert",
        phenomenes: []
    };

});


/* Exemple pour tester */

vigilance["35"] = {
    niveau: "jaune",
    phenomenes: ["Orages"]
};

vigilance["29"] = {
    niveau: "orange",
    phenomenes: ["Vent"]
};


/* --------------------------------
   COULEURS
-------------------------------- */

function classeVigilance(code) {

    const niveau = vigilance[code]?.niveau || "vert";

    return niveau;
}


/* --------------------------------
   DESSIN DE LA FRANCE
-------------------------------- */

svg.selectAll(".departement")
    .data(donnees.features)
    .join("path")
    .attr("class", dep =>
        `departement ${classeVigilance(dep.properties.code)}`
    )
    .attr("d", path)
    .on("click", function(event, dep) {

        const code = dep.properties.code;
        const nom = dep.properties.nom;

        const info = vigilance[code];

        document.querySelector("#infos").innerHTML = `
            <h2>${code} — ${nom}</h2>

            <p>
                <strong>Vigilance :</strong>
                ${info.niveau.toUpperCase()}
            </p>

            <p>
                <strong>Phénomènes :</strong>
                ${
                    info.phenomenes.length
                    ? info.phenomenes.join(", ")
                    : "Aucun"
                }
            </p>
        `;

    });

</script>

</body>
</html>
VERT / JAUNE / ORANGE / ROUGE
🌩️ ORAGES
🌧️ PLUIE-INONDATION
💨 VENT
🌊 CRUES
❄️ NEIGE-VERGLAS
🥵 CANICULE
🥶 GRAND FROID
🌊 VAGUES-SUBMERSION

<div id="controle">

    <h2>⚙️ Modifier la vigilance</h2>

    <label for="departement">Département :</label>

    <select id="departement">
        <option value="">-- Choisir --</option>
    </select>


    <label for="phenomene">Phénomène :</label>

    <select id="phenomene">
        <option value="orages">🌩️ Orages</option>
        <option value="pluie_inondation">🌧️ Pluie-inondation</option>
        <option value="vent">💨 Vent</option>
        <option value="crues">🌊 Crues</option>
        <option value="neige_verglas">❄️ Neige-verglas</option>
        <option value="canicule">🥵 Canicule</option>
        <option value="grand_froid">🥶 Grand froid</option>
        <option value="vagues_submersion">🌊 Vagues-submersion</option>
    </select>


    <label for="niveau">Niveau :</label>

    <select id="niveau">
        <option value="vert">🟢 Vert</option>
        <option value="jaune">🟡 Jaune</option>
        <option value="orange">🟠 Orange</option>
        <option value="rouge">🔴 Rouge</option>
    </select>


    <button id="appliquer">Appliquer</button>

</div> 

#controle {
    width: 90%;
    max-width: 600px;
    margin: 20px auto;
    padding: 20px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 3px 10px #0002;
}

#controle h2 {
    margin-top: 0;
}

#controle label {
    display: block;
    margin-top: 12px;
    font-weight: bold;
}

#controle select,
#controle button {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    font-size: 16px;
    border-radius: 8px;
}

#controle button {
    margin-top: 18px;
    cursor: pointer;
    border: none;
}
const selectDepartement = document.getElementById("departement");

departements.forEach(departement => {

    const code = departement.properties.code;
    const nom = departement.properties.nom;

    const option = document.createElement("option");

    option.value = code;
    option.textContent = `${code} - ${nom}`;

    selectDepartement.appendChild(option);
});

document.getElementById("appliquer").addEventListener("click", () => {

    const code = document.getElementById("departement").value;
    const phenomene = document.getElementById("phenomene").value;
    const niveau = document.getElementById("niveau").value;

    if (!code) {
        alert("Choisis d'abord un département.");
        return;
    }

    // Modification de la vigilance
    vigilance[code][phenomene] = niveau;

    // Actualisation de la carte
    d3.selectAll(".departement")
        .attr("class", departement => {

            const codeDepartement = departement.properties.code;

            return "departement " +
                   vigilance[codeDepartement].orages;

<script>

const infos = document.getElementById("infos");

let departements = [];
let vigilance = {};

fetch("https://raw.githubusercontent.com/gregoiredavid/france-geojson/master/departements-version-simplifiee.geojson")
.then(reponse => reponse.json())
.then(geojson => {

    // 🇫🇷 France métropolitaine uniquement
    departements = geojson.features.filter(departement => {

        const code = departement.properties.code;

        return !["971", "972", "973", "974", "976"].includes(code);
    });

    // Crée automatiquement la vigilance de chaque département
    departements.forEach(departement => {

        const code = departement.properties.code;

        vigilance[code] = {
            orages: "vert",
            pluie_inondation: "vert",
            vent: "vert",
            crues: "vert",
            neige_verglas: "vert",
            canicule: "vert",
            grand_froid: "vert",
            vagues_submersion: "vert"
        };

    });


    // Quelques tests
    vigilance["35"].orages = "orange";
    vigilance["29"].vent = "jaune";
    vigilance["44"].pluie_inondation = "orange";


    // Remplissage du menu des départements
    const selectDepartement =
        document.getElementById("departement");

    departements
        .sort((a, b) =>
            a.properties.code.localeCompare(
                b.properties.code,
                "fr",
                {numeric: true}
            )
        )
        .forEach(departement => {

            const option = document.createElement("option");

            option.value = departement.properties.code;

            option.textContent =
                `${departement.properties.code} - ${departement.properties.nom}`;

            selectDepartement.appendChild(option);

        });


    // Création de la carte
    const projection = d3.geoMercator()
        .fitSize(
            [900, 700],
            {
                type: "FeatureCollection",
                features: departements
            }
        );


    const chemin = d3.geoPath()
        .projection(projection);


    d3.select("#carte")
        .selectAll(".departement")
        .data(departements)
        .enter()
        .append("path")
        .attr("class", departement => {

            const code = departement.properties.code;

            return "departement " +
                   vigilance[code].orages;

        })
        .attr("d", chemin)

        .on("click", function(event, departement) {

            const code = departement.properties.code;
            const nom = departement.properties.nom;

            infos.innerHTML = `
                <h2>${nom}</h2>
                <p><strong>Code :</strong> ${code}</p>
                <p>🌩️ Orages : ${vigilance[code].orages}</p>
                <p>🌧️ Pluie-inondation : ${vigilance[code].pluie_inondation}</p>
                <p>💨 Vent : ${vigilance[code].vent}</p>
                <p>🌊 Crues : ${vigilance[code].crues}</p>
                <p>❄️ Neige-verglas : ${vigilance[code].neige_verglas}</p>
                <p>🥵 Canicule : ${vigilance[code].canicule}</p>
                <p>🥶 Grand froid : ${vigilance[code].grand_froid}</p>
                <p>🌊 Vagues-submersion : ${vigilance[code].vagues_submersion}</p>
            `;

        });


    // Bouton APPLIQUER
    document.getElementById("appliquer")
        .addEventListener("click", function() {

            const code =
                document.getElementById("departement").value;

            const phenomene =
                document.getElementById("phenomene").value;

            const niveau =
                document.getElementById("niveau").value;


            if (!code) {

                alert("Choisis un département.");

                return;
            }


            // Modification
            vigilance[code][phenomene] = niveau;


            // Pour l'instant la carte affiche les ORAGES
            d3.selectAll(".departement")
                .attr("class", departement => {

                    const codeDepartement =
                        departement.properties.code;

                    return "departement " +
                           vigilance[codeDepartement].orages;

                });


            console.log(
                "Modification :",
                code,
                phenomene,
                niveau
            );

        });

})
.catch(erreur => {

    console.error("Erreur :", erreur);

    infos.innerHTML = `
        <h2>❌ Erreur</h2>
        <p>Impossible de charger la carte.</p>
    `;

});

</script>

        });

});

<script src="https://cdn.jsdelivr.net/npm/d3@7"></script>

<select id="departement">

<select id="phenomene">

<select id="niveau">


<button id="appliquer">Appliquer</button>
